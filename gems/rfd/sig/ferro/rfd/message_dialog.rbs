module Ferro
  module Rfd
    class MessageDialog
      include Builder

      @consumed_by: String?
      @level: MessageLevel
      @title: String?
      @description: String?
      @buttons: MessageButtons
      @parent: native_parent?

      def self.default: () -> MessageDialog

      def initialize: () -> void
      def set_level: (MessageLevel level) -> self
      def set_title: (String text) -> self
      def set_description: (String text) -> self
      def set_buttons: (MessageButtons btn) -> self
      def set_parent: (_Parent parent) -> self
      def show: () -> MessageDialogResult
      def debug: () -> String

      private

      def settings: () -> native_message_settings
    end
  end
end
