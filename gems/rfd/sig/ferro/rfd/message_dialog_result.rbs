module Ferro
  module Rfd
    module MessageDialogResult
      class Value
        include MessageDialogResult

        @name: Symbol

        private def self.new: (Symbol name) -> instance

        def initialize: (Symbol name) -> void
        def to_s: () -> String
        def ==: (Object other) -> bool
        def eql?: (Object other) -> bool
        def hash: () -> Integer
      end

      Yes: MessageDialogResult
      No: MessageDialogResult
      Ok: MessageDialogResult
      Cancel: MessageDialogResult

      private def self.from_native: (native_result tuple) -> MessageDialogResult
      private def self.to_native: (MessageDialogResult result) -> native_result

      def self.default: () -> MessageDialogResult

      def debug: () -> String

      class Custom < Data
        include MessageDialogResult

        attr_reader custom: String

        def self.new: (String custom) -> instance
                    | (custom: String) -> instance

        def to_s: () -> String
      end
    end
  end
end
