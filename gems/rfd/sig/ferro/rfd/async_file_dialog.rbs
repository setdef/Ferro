module Ferro
  module Rfd
    class AsyncFileDialog
      @file_dialog: FileDialog

      def initialize: () -> void
      def add_filter: (String name, Array[_ToS] extensions) -> self
      def set_directory: (String | _ToPath path) -> self
      def set_file_name: (String file_name) -> self
      def set_title: (String title) -> self
      def set_parent: (_Parent parent) -> self
      def set_can_create_directories: (boolish can) -> self
      def pick_file: () -> Future
      def pick_files: () -> Future
      def pick_folder: () -> Future
      def pick_folders: () -> Future
      def save_file: () -> Future
      def inspect: () -> String

      private

      def start: (Symbol call) -> Future
    end
  end
end
