module Ferro
  module Rfd
    class MessageLevel
      Info: MessageLevel
      Warning: MessageLevel
      Error: MessageLevel

      @name: Symbol

      private def self.new: (Symbol name) -> instance
      private def self.variant: (Object level) -> Symbol

      def self.default: () -> MessageLevel

      def initialize: (Symbol name) -> void
      def inspect: () -> String
    end
  end
end
