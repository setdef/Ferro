module Ferro
  module Idna
    module Uts46
      class ProcessingError < StandardError
        class ValidityError < ProcessingError
          def initialize: (?String? message) -> void
          def debug: () -> String
        end

        class SinkError < ProcessingError
          def initialize: (?String? message) -> void
          def debug: () -> String
        end
      end
    end
  end
end
