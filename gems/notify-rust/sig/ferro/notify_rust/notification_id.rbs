module Ferro
  module NotifyRust
    module NotificationId : Object
      class Xdg < Data
        include TupleVariant
        include NotificationId

        attr_reader value: Integer

        def self.new: (Integer value) -> instance
                    | (value: Integer) -> instance

        private

        def to_native: () -> [:Xdg, Integer]
      end

      class Mac < Data
        include TupleVariant
        include NotificationId

        attr_reader value: String

        def self.new: (String value) -> instance
                    | (value: String) -> instance

        private

        def to_native: () -> [:Mac, String]
      end

      def self.from: (Integer | String value) -> (Xdg | Mac)
      def debug: () -> String
    end
  end
end
