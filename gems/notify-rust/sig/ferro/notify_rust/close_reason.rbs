module Ferro
  module NotifyRust
    module CloseReason : Object
      class Unit
        include CloseReason

        @name: :Expired | :Dismissed | :CloseAction

        def initialize: (:Expired | :Dismissed | :CloseAction name) -> void

        private

        def to_native: () -> (:Expired | :Dismissed | :CloseAction)
      end

      Expired: Unit
      Dismissed: Unit
      CloseAction: Unit

      class Other < Data
        include TupleVariant
        include CloseReason

        attr_reader raw_reason: Integer

        def self.new: (Integer raw_reason) -> instance
                    | (raw_reason: Integer) -> instance

        private

        def to_native: () -> Integer
      end

      def self.from: (Integer raw_reason) -> (Unit | Other)
      private def self.from_native: (close_reason_tag tag) -> (Unit | Other)
      private def self.tag_of: (Object reason) -> close_reason_tag

      def debug: () -> String
    end
  end
end
