module Ferro
  module NotifyRust
    class Error < StandardError
      class Msg < Error
      end

      class Parse < Error
      end

      class SpecVersion < Error
      end

      class Conversion < Error
      end

      class ImplementationMissing < Error
        def initialize: (?String? message) -> void
      end
    end
  end
end
