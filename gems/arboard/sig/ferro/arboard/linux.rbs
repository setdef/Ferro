module Ferro
  module Arboard
    class LinuxClipboardKind
      Clipboard: LinuxClipboardKind
      Primary: LinuxClipboardKind
      Secondary: LinuxClipboardKind

      @name: Symbol

      private def self.new: (Symbol name) -> instance
      private def self.variant: (Object selection) -> Symbol

      def initialize: (Symbol name) -> void
      def debug: () -> String
    end

    module Native
      def self.linux_clipboard_kind_debug: (Symbol name) -> String
    end

    module GetExtLinux : Builder
      @selection: Symbol?

      def clipboard: (LinuxClipboardKind selection) -> self
    end

    module SetExtLinux : Builder
      @selection: Symbol?
      @wait: (:forever | :once | Float)?
      @exclude_from_history: bool

      def wait: () -> self
      def wait_until: (Numeric deadline) -> self
      def wait_once: () -> self
      def clipboard: (LinuxClipboardKind selection) -> self
      def exclude_from_history: () -> self
    end

    module ClearExtLinux : Builder
      @clipboard: Clipboard

      def clipboard: (LinuxClipboardKind selection) -> void
    end

    class Get
      include GetExtLinux
    end

    class Set
      include SetExtLinux
    end

    class Clear
      include ClearExtLinux
    end
  end
end
