module Ferro
  module GlobalHotkey
    class HotKeyState
      include Comparable

      Pressed: HotKeyState
      Released: HotKeyState

      @name: Symbol
      @index: Integer

      private def self.new: (Symbol name, Integer index) -> instance

      def self._load: (String name) -> HotKeyState

      def initialize: (Symbol name, Integer index) -> void
      def _dump: (Integer level) -> String
      def debug: () -> String
      def to_i: () -> Integer
      def <=>: (Object other) -> Integer?

    end
  end
end
