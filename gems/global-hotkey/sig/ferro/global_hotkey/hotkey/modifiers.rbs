module Ferro
  module GlobalHotkey
    module Hotkey
      class Modifiers
        include Comparable

        ALT: Modifiers
        ALT_GRAPH: Modifiers
        CAPS_LOCK: Modifiers
        CONTROL: Modifiers
        FN: Modifiers
        FN_LOCK: Modifiers
        META: Modifiers
        NUM_LOCK: Modifiers
        SCROLL_LOCK: Modifiers
        SHIFT: Modifiers
        SYMBOL: Modifiers
        SYMBOL_LOCK: Modifiers
        HYPER: Modifiers
        SUPER: Modifiers
        FLAGS: Array[Flag]

        class Flag < Data
          attr_reader name: String
          attr_reader value: Modifiers

          def self.new: (String name, Modifiers value) -> Flag
                      | (name: String, value: Modifiers) -> Flag

          def is_named: () -> bool
          def is_unnamed: () -> bool
          def debug: () -> String
        end

        attr_reader bits: Integer

        private def self.new: (Integer bits) -> instance

        def self.empty: () -> Modifiers
        ALL: Modifiers

        def self.all: () -> Modifiers
        def self.default: () -> Modifiers
        def self.from_bits: (Integer bits) -> Modifiers?
        def self.from_bits_truncate: (Integer bits) -> Modifiers
        def self.from_bits_retain: (Integer bits) -> Modifiers
        def self.all_named: () -> Modifiers
        def self.from_name: (String name) -> Modifiers?

        def initialize: (Integer bits) -> void
        def is_empty: () -> bool
        def is_all: () -> bool
        def known_bits: () -> Integer
        def unknown_bits: () -> Integer
        def contains_unknown_bits: () -> bool
        def contains: (Modifiers other) -> bool
        def intersects: (Modifiers other) -> bool
        def union: (Modifiers other) -> Modifiers
        def |: (Modifiers other) -> Modifiers
        def intersection: (Modifiers other) -> Modifiers
        def &: (Modifiers other) -> Modifiers
        def difference: (Modifiers other) -> Modifiers
        def -: (Modifiers other) -> Modifiers
        def symmetric_difference: (Modifiers other) -> Modifiers
        def ^: (Modifiers other) -> Modifiers
        def complement: () -> Modifiers
        def ~: () -> Modifiers
        def iter: () -> Enumerator[Modifiers, void]
        def each: () { (Modifiers flag) -> void } -> void
                | () -> Enumerator[Modifiers, void]
        def iter_names: () -> Enumerator[[String, Modifiers], void]
        def shift: () -> bool
        def ctrl: () -> bool
        def alt: () -> bool
        def meta: () -> bool
        def <=>: (Object other) -> Integer?
        def eql?: (Object other) -> bool
        def hash: () -> Integer
        def debug: () -> String

        private

        def names_and_remaining: () -> [Array[[String, Modifiers]], Integer]
        def bits_of: (Object other) -> Integer
      end
    end
  end
end
