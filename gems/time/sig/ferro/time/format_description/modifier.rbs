module Ferro
  module Time
    module FormatDescription
      module Modifier
        type kind = singleton(Enum) | :bool | :count
        type field = Enum | bool | Integer

        module Value : Data
          def initialize: (**field fields) -> void
          def inspect: () -> String

          private

          def encode: () -> encoded_component
        end

        class Enum
          @index: Integer
          @name: Symbol

          private def self.new: (Integer index, Symbol name) -> instance

          def initialize: (Integer index, Symbol name) -> void
          def inspect: () -> String

          private

          attr_reader index: Integer
        end


        class MonthRepr < Enum
          Numerical: MonthRepr
          Long: MonthRepr
          Short: MonthRepr

          ALL: Array[MonthRepr]

          def self.default: () -> MonthRepr
        end

        class WeekdayRepr < Enum
          Short: WeekdayRepr
          Long: WeekdayRepr
          Sunday: WeekdayRepr
          Monday: WeekdayRepr

          ALL: Array[WeekdayRepr]

          def self.default: () -> WeekdayRepr
        end

        class WeekNumberRepr < Enum
          Iso: WeekNumberRepr
          Sunday: WeekNumberRepr
          Monday: WeekNumberRepr

          ALL: Array[WeekNumberRepr]

          def self.default: () -> WeekNumberRepr
        end

        class YearRepr < Enum
          Full: YearRepr
          Century: YearRepr
          LastTwo: YearRepr

          ALL: Array[YearRepr]

          def self.default: () -> YearRepr
        end

        class YearRange < Enum
          Standard: YearRange
          Extended: YearRange

          ALL: Array[YearRange]

          def self.default: () -> YearRange
        end

        class SubsecondDigits < Enum
          One: SubsecondDigits
          Two: SubsecondDigits
          Three: SubsecondDigits
          Four: SubsecondDigits
          Five: SubsecondDigits
          Six: SubsecondDigits
          Seven: SubsecondDigits
          Eight: SubsecondDigits
          Nine: SubsecondDigits
          OneOrMore: SubsecondDigits

          ALL: Array[SubsecondDigits]

          def self.default: () -> SubsecondDigits
        end

        class Padding < Enum
          Space: Padding
          Zero: Padding
          None: Padding

          ALL: Array[Padding]

          def self.default: () -> Padding
        end

        class UnixTimestampPrecision < Enum
          Second: UnixTimestampPrecision
          Millisecond: UnixTimestampPrecision
          Microsecond: UnixTimestampPrecision
          Nanosecond: UnixTimestampPrecision

          ALL: Array[UnixTimestampPrecision]

          def self.default: () -> UnixTimestampPrecision
        end

        class TrailingInput < Enum
          Prohibit: TrailingInput
          Discard: TrailingInput

          ALL: Array[TrailingInput]

          def self.default: () -> TrailingInput
        end

        class Day < Data
          include Value

          KINDS: Hash[Symbol, kind]
          DEFAULT: Day

          attr_reader padding: Padding

          private def self.new: (padding: Padding) -> instance
                              | (Padding padding) -> instance

          def self.default: () -> Day
          def with_padding: (Padding padding) -> Day
        end

