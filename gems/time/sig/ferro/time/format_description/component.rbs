module Ferro
  module Time
    module FormatDescription
      module Component
        def self.try_from: (BorrowedFormatItem | OwnedFormatItem item) -> Component

        def initialize: (modifier: Data) -> void
        def ==: (Object other) -> bool
        def inspect: () -> String

        private

        def encode: () -> Array[String | Modifier::field]


        class Day < Data
          include Component

          attr_reader modifier: Modifier::Day

          def self.new: (modifier: Modifier::Day) -> instance
                      | (Modifier::Day modifier) -> instance
        end

