module Ferro
  module Time
    module FormatDescription
      module Component : Object
        include TupleVariant[Data]

        def self.try_from: (BorrowedFormatItem | OwnedFormatItem item) -> Component

        def ==: (Object other) -> bool
        def debug: () -> String

        private

        def check: (Data modifier) -> Data
        def encode: () -> Array[String | Modifier::field]

        class Day
          include Component
        end

        class MonthShort
          include Component
        end

        class MonthLong
          include Component
        end

        class MonthNumerical
          include Component
        end

        class Ordinal
          include Component
        end

        class WeekdayShort
          include Component
        end

        class WeekdayLong
          include Component
        end

        class WeekdaySunday
          include Component
        end

        class WeekdayMonday
          include Component
        end

        class WeekNumberIso
          include Component
        end

        class WeekNumberSunday
          include Component
        end

        class WeekNumberMonday
          include Component
        end

        class CalendarYearFullExtendedRange
          include Component
        end

        class CalendarYearFullStandardRange
          include Component
        end

        class IsoYearFullExtendedRange
          include Component
        end

        class IsoYearFullStandardRange
          include Component
        end

        class CalendarYearCenturyExtendedRange
          include Component
        end

        class CalendarYearCenturyStandardRange
          include Component
        end

        class IsoYearCenturyExtendedRange
          include Component
        end

        class IsoYearCenturyStandardRange
          include Component
        end

        class CalendarYearLastTwo
          include Component
        end

        class IsoYearLastTwo
          include Component
        end

        class Hour12
          include Component
        end

        class Hour24
          include Component
        end

        class Minute
          include Component
        end

        class Period
          include Component
        end

        class Second
          include Component
        end

        class Subsecond
          include Component
        end

        class OffsetHour
          include Component
        end

        class OffsetMinute
          include Component
        end

        class OffsetSecond
          include Component
        end

        class Ignore
          include Component
        end

        class UnixTimestampSecond
          include Component
        end

        class UnixTimestampMillisecond
          include Component
        end

        class UnixTimestampMicrosecond
          include Component
        end

        class UnixTimestampNanosecond
          include Component
        end

        class End
          include Component
        end

        CLASSES: Hash[Symbol, Class]
      end
    end
  end
end
