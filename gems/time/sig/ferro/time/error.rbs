module Ferro
  module Time
    class Error < StandardError
      def initialize: (?String? message) -> void
      def source: () -> Error?
      private def self.refuse_unless_enum: (singleton(Error) owner, Symbol name) -> void

      class ConversionRange < Error
      end

      class ComponentRange < Error
        def self.try_from: (Error error) -> ComponentRange

        attr_reader name: String
        attr_reader is_conditional: bool

        def initialize: (String name, bool is_conditional) -> void
      end

      class IndeterminateOffset < Error
      end

      class DifferentVariant < Error
      end

      class InvalidVariant < Error
      end

      class Format < Error
        def self.from: (Error::ComponentRange component_range) -> Format::ComponentRange

        class InsufficientTypeInformation < Format
        end

        class InvalidComponent < Format
          @component: String

          def initialize: (String component) -> void
          def deconstruct: () -> [String]
          def to_a: () -> [String]
        end

        class ComponentRange < Format
          @name: String
          @is_conditional: bool

          def initialize: (String name, bool is_conditional) -> void
          def source: () -> Error::ComponentRange
          def deconstruct: () -> [Error::ComponentRange]
          def to_a: () -> [Error::ComponentRange]
        end

        class StdIo < Format
          def deconstruct: () -> [nil]
          def to_a: () -> [nil]
        end
      end

      class ParseFromDescription < Error
        def self.try_from: (Error error) -> ParseFromDescription

        class InvalidLiteral < ParseFromDescription
        end

        class InvalidComponent < ParseFromDescription
          @name: String

          def initialize: (String name) -> void
          def deconstruct: () -> [String]
          def to_a: () -> [String]
        end

        class UnexpectedTrailingCharacters < ParseFromDescription
        end
      end

      class TryFromParsed < Error
        def self.try_from: (Error error) -> TryFromParsed
        def self.from: (Error::ComponentRange component_range) -> TryFromParsed::ComponentRange

        class InsufficientInformation < TryFromParsed
        end

        class ComponentRange < TryFromParsed
          @name: String
          @is_conditional: bool

          def initialize: (String name, bool is_conditional) -> void
          def source: () -> Error::ComponentRange
          def deconstruct: () -> [Error::ComponentRange]
          def to_a: () -> [Error::ComponentRange]
        end
      end

      class Parse < Error
        def self.from: (Error::TryFromParsed | Error::ParseFromDescription error) -> Parse

        class TryFromParsed < Parse
          def source: () -> Error::TryFromParsed
          def deconstruct: () -> [Error::TryFromParsed]
          def to_a: () -> [Error::TryFromParsed]

          class InsufficientInformation < TryFromParsed
          end

          class ComponentRange < TryFromParsed
            @name: String
            @is_conditional: bool

            def initialize: (String name, bool is_conditional) -> void
            def source: () -> Error::TryFromParsed::ComponentRange
          end
        end

        class ParseFromDescription < Parse
          def source: () -> Error::ParseFromDescription
          def deconstruct: () -> [Error::ParseFromDescription]
          def to_a: () -> [Error::ParseFromDescription]

          class InvalidLiteral < ParseFromDescription
          end

          class InvalidComponent < ParseFromDescription
            @name: String

            def initialize: (String name) -> void
            def source: () -> Error::ParseFromDescription::InvalidComponent
          end

          class UnexpectedTrailingCharacters < ParseFromDescription
          end
        end
      end

      class InvalidFormatDescription < Error
        class UnclosedOpeningBracket < InvalidFormatDescription
          attr_reader index: Integer

          def initialize: (Integer index) -> void
        end

        class InvalidComponentName < InvalidFormatDescription
          attr_reader name: String
          attr_reader index: Integer

          def initialize: (String name, Integer index) -> void
        end

        class InvalidModifier < InvalidFormatDescription
          attr_reader value: String
          attr_reader index: Integer

          def initialize: (String value, Integer index) -> void
        end

        class MissingComponentName < InvalidFormatDescription
          attr_reader index: Integer

          def initialize: (Integer index) -> void
        end

        class MissingRequiredModifier < InvalidFormatDescription
          attr_reader name: String
          attr_reader index: Integer

          def initialize: (String name, Integer index) -> void
        end

        class Expected < InvalidFormatDescription
          attr_reader what: String
          attr_reader index: Integer

          def initialize: (String what, Integer index) -> void
        end

        class NotSupported < InvalidFormatDescription
          attr_reader what: String
          attr_reader context: String
          attr_reader index: Integer

          def initialize: (String what, String context, Integer index) -> void
        end

        class DuplicateModifier < InvalidFormatDescription
          attr_reader name: String
          attr_reader index: Integer

          def initialize: (String name, Integer index) -> void
        end

        class InvalidModifierCombination < InvalidFormatDescription
          attr_reader modifier: String
          attr_reader context: String
          attr_reader index: Integer

          def initialize: (String modifier, String context, Integer index) -> void
        end
      end
    end
  end
end
